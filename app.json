{
  "expo": {
    "name": "AquaCredit",
    "slug": "AquaCredit",
    "version": "1.0.0",
    "owner": "pentapillisuresh",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aquacredit",
    "userInterfaceStyle": "automatic",
    "useNextNotificationsApi": true,
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sureshpentapilli.aquacredit",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow $(PRODUCT_NAME) to use Face ID to securely authenticate you and protect your financial data."
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-build-properties",
      "@react-native-firebase/app",
      "expo-applinks"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/aqualogo.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08248e48-60f1-456a-b9f0-32f8a75b08c3"
      }
    },
    "android": {
      "package": "com.sureshpentapilli.aquacredit",
      "googleServicesFile": "./android/app/google-services.json",
      "useNextNotificationsApi": true,
      "permissions": [
        "USE_BIOMETRIC"
      ],
      "associatedDomains": [
        "applinks:aquaadmin.esotericprojects.tech"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": {
            "scheme": "https",
            "host": "aquaadmin.esotericprojects.tech",
            "pathPrefix": "/refer"
          }
        }
      ]
    }
  }
}
